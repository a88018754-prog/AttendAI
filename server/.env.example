PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_attendance
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# The admin account is created/updated from these values on server start
ADMIN_EMAIL=admin@institute.edu
ADMIN_PASSWORD=Admin@123

# Timezone used for attendance time rules and the absent job
TZ_NAME=Asia/Kolkata

# Set to true only if running behind a reverse proxy (nginx, render, etc.)
TRUST_PROXY=false
